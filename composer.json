{
  "name": "yourpayments/php-api-client",
  "description": "Your Payments - powerful payment gateway PHP integration",
  "type": "package",
  "keywords": ["payments", "processing"],
  "require": {
    "php": ">=7.4.0",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "suggest": {
    "psr/log": "Для журналирования запросов через ApiRequest::setLogger() (любой PSR-3 логгер: Monolog, Laravel и др.)"
  },
  "license": "mit",
  "authors": [
    {
      "name": "YPMN Team",
      "email": "itsupport@ypmn.ru",
      "homepage": "https://dev.ypmn.ru/ru/documents/apiv4/"
    }
  ],
  "minimum-stability": "dev",
  "autoload": {
    "psr-4": {
      "Ypmn\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ypmn\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
